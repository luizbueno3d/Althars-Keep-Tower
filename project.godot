; Engine configuration file.
; Althar's Keep — Tower. A parallel tower-defence experiment that shares
; the proven rules engine with Althar's Keep (see README.md).

config_version=5

[application]

config/name="Althar's Keep — Tower"
config/description="Tower-defence sibling of Althar's Keep. Low-poly presentation, shared simulation rules."
run/main_scene="res://scenes/tower.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

